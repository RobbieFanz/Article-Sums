# Copy this file to .env and set OLLAMA_MODEL to a model shown by `ollama list`.
# Never commit .env; it can contain private SMTP credentials in a later version.
OLLAMA_MODEL=replace-with-your-installed-ollama-model
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=180

# Paths are relative to the project root unless you provide an absolute path.
LANDING_DIR=data/landing
ARCHIVE_DIR=data/archive
BRIEFING_DIR=data/briefings
ARTICLE_HISTORY_PATH=data/article-history.sqlite3

# With chunking disabled, article text above this limit is truncated.
MAX_ARTICLE_CHARACTERS=24000
# Chunk long articles and combine their summaries; disable for a single model call.
CHUNKED_SUMMARIZATION=true
# Approximate character budget per chunk, not a token or context-window guarantee.
SUMMARY_CHUNK_CHARACTERS=9500
RELEVANCE_CRITERIA_FILE=config/relevance_criteria.txt
# Relevance triage uses an excerpt so it can quickly filter articles before full summary.
RELEVANCE_MAX_ARTICLE_CHARACTERS=6000

# Email delivery is disabled until SMTP credentials are configured below.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-your-smtp-username
SMTP_PASSWORD=replace-with-your-smtp-password-or-app-password
SMTP_FROM=your-address@example.com
SMTP_TO=recipient@example.com
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=30
